[run]
branch = True
relative_files = True
source = .
omit =
    */migrations/*
    */tests.py
    */test_*.py
    */*_tests.py
    */manage.py
    */scripts/*
    */frontend/*
    */node_modules/*
    */.next/*
    */.venv*/*
    */venv/*
    */.git/*
    */htmlcov/*
    */staticfiles/*
    */.tmp/*

[report]
show_missing = True
skip_covered = True
precision = 2
